# Netlify → Site configuration → Environment variables дээр оруулна. (Энэ файлыг GitHub-д .env нэрээр битгий оруул.)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...        # Project Settings → API → anon public
SUPABASE_SERVICE_KEY=eyJ...     # Project Settings → API → service_role (НУУЦ! зөвхөн Netlify функцэд)
ROOT_DOMAIN=splus.news
